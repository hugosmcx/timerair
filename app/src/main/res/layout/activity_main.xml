<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="32dp">

        <!-- ── App title ──────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="TimerAir"
            android:textColor="@color/accent_cyan"
            android:textSize="13sp"
            android:letterSpacing="0.3"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="true" />

        <!-- ── Live clock card ───────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#1AFFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HORA ATUAL"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"
                    android:textColor="@color/text_hint"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:contentDescription="@string/content_desc_clock"
                    android:textSize="52sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-light"
                    android:letterSpacing="0.05"
                    tools:text="11:34" />


            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Wake-up time card ─────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#1AFFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HORÁRIO DE ACORDAR"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"
                    android:textColor="@color/text_hint"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="true" />

                <!-- Time display + edit button row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvWakeTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="42sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-light"
                        tools:text="06:00" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickTime"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alterar"
                        android:textColor="@color/accent_cyan"
                        app:strokeColor="@color/accent_cyan"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvWakeInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_hint"
                    tools:text="30 min antes → desliga às 05:30" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Result card ───────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#12006080"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/accent_cyan"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONFIGURE O TIMER EM"
                    android:textSize="11sp"
                    android:letterSpacing="0.2"
                    android:textColor="@color/accent_cyan"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="true"
                    android:alpha="0.8" />

                <!-- Big result number -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvResultHours"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/content_desc_result"
                        android:textSize="80sp"
                        android:textColor="@color/accent_cyan"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingExtra="0dp"
                        android:includeFontPadding="false"
                        tools:text="7,5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        android:layout_marginStart="6dp"
                        android:text="h"
                        android:textSize="28sp"
                        android:textColor="@color/accent_cyan"
                        android:fontFamily="sans-serif-light"
                        android:alpha="0.7" />
                </LinearLayout>

                <!-- AC off time -->
                <TextView
                    android:id="@+id/tvAcOffTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_secondary"
                    tools:text="O ar vai desligar por volta das 05:30" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── How-it-works hint ─────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Timer arredondado para múltiplos de 0,5 h"
                android:textSize="12sp"
                android:textColor="@color/text_hint" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
